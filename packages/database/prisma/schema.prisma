  cedentDimensionEntryId String?               @map("cedent_dimension_entry_id")
  code                   String?
  cedentName             String                @map("cedent_name")
  limitGlobal            Decimal               @default(0) @map("limit_global") @db.Decimal(24, 10)
  limitUsed              Decimal               @default(0) @map("limit_used") @db.Decimal(24, 10)
  limitAvailable         Decimal               @default(0) @map("limit_available") @db.Decimal(24, 10)
  overdueAmount          Decimal               @default(0) @map("overdue_amount") @db.Decimal(24, 10)
  pendingFinancialAmount Decimal               @default(0) @map("pending_financial_amount") @db.Decimal(24, 10)
  checkProblemAmount     Decimal               @default(0) @map("check_problem_amount") @db.Decimal(24, 10)
  checkToConfirmAmount   Decimal               @default(0) @map("check_to_confirm_amount") @db.Decimal(24, 10)
  proofOkAmount          Decimal               @default(0) @map("proof_ok_amount") @db.Decimal(24, 10)
  trancheTotal           Decimal               @default(0) @map("tranche_total") @db.Decimal(24, 10)
