generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FundType {
  FIDC
  FII
  FIM
  FIA
  RENDA_FIXA
  MULTIMERCADO
  OUTRO
}

enum FundStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum FundAccessLevel {
  VIEW
  MANAGE
}

enum DreAccountType {
  REVENUE
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

enum CashAccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  OTHER
}

enum CashAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum CashTransactionType {
  CREDIT
  DEBIT
}

enum ImportModule {
  FUNDS
  QUOTES
  DRE
  CASH
  POSITIONS
  USERS
  RECEIVABLE_STOCK
  RISK_LIMITS
  CEDENT_DIMENSION
  FIDC_OPEN_MOVEMENT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                 String                    @id @default(cuid())
  name               String
  email              String                    @unique
  passwordHash       String
  status             UserStatus                @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  auditLogs          AuditLog[]
  dimensionSnapshots CedentDimensionSnapshot[]
  fundAccesses       UserFundAccess[]
  importBatches      ImportBatch[]
  roles              UserRole[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Fund {
  id                  String                    @id @default(cuid())
  name                String
  shortName           String
  cnpj                String                    @unique
  fundType            FundType
  status              FundStatus                @default(ACTIVE)
  startDate           DateTime                  @db.Date
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  dreEntries          DreEntry[]
  fundCashFlows       FundCashFlow[]
  financialPositions  FinancialPosition[]
  importBatches       ImportBatch[]
  quotes              FundQuote[]
  receivablePositions ReceivableStockPosition[]
  userAccesses        UserFundAccess[]
  cashDailyBalances   CompanyCashDailyBalance[]

  @@map("funds")
}

model UserFundAccess {
  userId      String
  fundId      String
  accessLevel FundAccessLevel
  fund        Fund            @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fundId])
  @@map("user_fund_accesses")
}

model FundQuote {
  id             String   @id @default(cuid())
  fundId         String
  quoteDate      DateTime @db.Date
  quotaValue     Decimal  @db.Decimal(20, 8)
  netAssetValue  Decimal  @db.Decimal(20, 2)
  sharesQuantity Decimal  @db.Decimal(20, 8)
  dailyReturn    Decimal  @db.Decimal(12, 8)
  monthReturn    Decimal  @db.Decimal(12, 8)
  yearReturn     Decimal  @db.Decimal(12, 8)
  createdAt      DateTime @default(now())
  fund           Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, quoteDate])
  @@map("fund_quotes")
}

model DreAccount {
  id      String         @id @default(cuid())
  code    String         @unique
  name    String
  type    DreAccountType
  entries DreEntry[]

  @@map("dre_accounts")
}

model DreEntry {
  id            String     @id @default(cuid())
  fundId        String
  accountId     String
  referenceDate DateTime   @db.Date
  amount        Decimal    @db.Decimal(20, 2)
  description   String?
  source        String
  account       DreAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fund          Fund       @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId, referenceDate])
  @@map("dre_entries")
}

model CompanyCashAccount {
  id           String                   @id @default(cuid())
  name         String
  bankName     String
  accountType  CashAccountType
  status       CashAccountStatus        @default(ACTIVE)
  transactions CompanyCashTransaction[]

  @@map("company_cash_accounts")
}

model CompanyCashTransaction {
  id              String              @id @default(cuid())
  cashAccountId   String
  transactionDate DateTime            @db.Date
  description     String
  type            CashTransactionType
  amount          Decimal             @db.Decimal(20, 2)
  category        String
  source          String
  cashAccount     CompanyCashAccount  @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)

  @@index([cashAccountId, transactionDate])
  @@map("company_cash_transactions")
}

model FinancialPosition {
  id           String   @id @default(cuid())
  fundId       String
  positionDate DateTime @db.Date
  assetClass   String
  assetName    String
  quantity     Decimal  @db.Decimal(20, 8)
  grossValue   Decimal  @db.Decimal(20, 2)
  netValue     Decimal  @db.Decimal(20, 2)
  fund         Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId, positionDate])
  @@map("financial_positions")
}

model FundCashFlow {
  id          String   @id @default(cuid())
  fundId      String
  flowDate    DateTime @db.Date
  description String
  flowType    String
  assetClass  String
  assetCode   String
  amount      Decimal  @db.Decimal(20, 6)
  source      String   @default("QITECH")
  createdAt   DateTime @default(now())
  fund        Fund     @relation(fields: [fundId], references: [id])

  @@unique([fundId, flowDate, description, flowType, assetCode])
  @@map("fund_cash_flows")
}

model CompanyCashDailyBalance {
  id            String   @id @default(cuid())
  fundId        String
  referenceDate DateTime @db.Date

  receivingBalance      Decimal @default(0) @db.Decimal(18, 2)
  reconciliationBalance Decimal @default(0) @db.Decimal(18, 2)
  reserveBalance        Decimal @default(0) @db.Decimal(18, 2)
  paymentBalance        Decimal @default(0) @db.Decimal(18, 2)
  usedAmount            Decimal @default(0) @db.Decimal(18, 2)

  note        String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fund Fund @relation(fields: [fundId], references: [id])

  @@unique([fundId, referenceDate])
  @@index([referenceDate])
  @@map("company_cash_daily_balances")
}

model Carteira {
  id          String   @id @default(cuid())
  dataPosicao DateTime @map("data_posicao") @db.Date
  ativo       String
  valor       Decimal  @db.Decimal(24, 10)
  fundo       String
  dataAnalise DateTime @map("data_analise") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([dataAnalise, fundo])
  @@map("CARTEIRAS")
}

model CaixaSingulare {
  id                 String   @id @default(cuid())
  dataLiquidacao     DateTime @map("data_liquidacao") @db.Date
  tipoDeRegistro     Int      @map("tipo_de_registro")
  descricao          String   @map("descricao")
  entradas           Decimal  @default(0) @db.Decimal(24, 10)
  saidas             Decimal  @default(0) @map("saidas") @db.Decimal(24, 10)
  saldo              Decimal  @default(0) @db.Decimal(24, 10)
  historicoTraduzido String?  @map("historico_traduzido")
  idConta            Int?     @map("id_conta")
  banco              String?
  agencia            String?
  contaCorrente      String?  @map("conta_corrente")
  digito             String?
  contaInvestimento  String?  @map("conta_investimento")
  cpfDoCliente       String?  @map("cpf_do_cliente")
  clienteNome        String   @map("cliente_nome")
  clienteId          String   @map("cliente_id")
  dataAnalise        DateTime @map("data_analise") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([dataAnalise, clienteId])
  @@map("CAIXAS")
}

model ImportBatch {
  id                     String                    @id @default(cuid())
  importedByUserId       String
  module                 ImportModule
  fileName               String
  fileHash               String?
  source                 String?
  storageKey             String?
  referenceDate          DateTime?                 @db.Date
  fundId                 String?
  status                 ImportStatus              @default(PENDING)
  totalRows              Int                       @default(0)
  importedRows           Int                       @default(0)
  errorRows              Int                       @default(0)
  errorMessage           String?
  createdAt              DateTime                  @default(now())
  completedAt            DateTime?
  dimensionSnapshot      CedentDimensionSnapshot?
  fund                   Fund?                     @relation(fields: [fundId], references: [id], onDelete: Restrict)
  importedByUser         User                      @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)
  receivablePositions    ReceivableStockPosition[]
  riskLimitPositions     RiskLimitPosition[]
  fidcOpenMovements      FidcMovimentoAberto[]
  fidcSettledReceivables FidcLiquidadoBaixado[]

  @@index([module, referenceDate])
  @@index([fundId, referenceDate])
  @@map("import_batches")
}

model CedentDimensionSnapshot {
  id               String                 @id @default(cuid())
  batchId          String                 @unique
  referenceDate    DateTime?              @db.Date
  rowCount         Int                    @default(0)
  importedByUserId String?
  createdAt        DateTime               @default(now())
  batch            ImportBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  importedByUser   User?                  @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  entries          CedentDimensionEntry[]

  @@index([referenceDate, createdAt])
  @@map("cedent_dimension_snapshots")
}

model CedentDimensionEntry {
  id            String                  @id @default(cuid())
  snapshotId    String
  code          String
  commercial    String?
  groupName     String?                 @map("group_name")
  cedentName    String
  createdAt     DateTime                @default(now())
  snapshot      CedentDimensionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  riskPositions RiskLimitPosition[]

  @@unique([snapshotId, code])
  @@index([code])
  @@map("cedent_dimension_entries")
}

model ReceivableStockPosition {
  id                  String      @id @default(cuid())
  batchId             String
  fundId              String
  fundName            String      @map("fund_name")
  fundDocument        String      @map("fund_document")
  fundDate            DateTime?   @map("fund_date") @db.Date
  originatorName      String?     @map("originator_name")
  originatorDocument  String?     @map("originator_document")
  cedentName          String      @map("cedent_name")
  cedentDocument      String      @map("cedent_document")
  debtorName          String      @map("debtor_name")
  debtorDocument      String      @map("debtor_document")
  yourNumber          String?     @map("your_number")
  documentKey         String?     @map("document_key")
  status              String?
  documentNumber      String?     @map("document_number")
  receivableType      String?     @map("receivable_type")
  nominalValue        Decimal     @default(0) @map("nominal_value") @db.Decimal(24, 10)
  presentValue        Decimal     @default(0) @map("present_value") @db.Decimal(24, 10)
  acquisitionValue    Decimal     @default(0) @map("acquisition_value") @db.Decimal(24, 10)
  pddValue            Decimal     @default(0) @map("pdd_value") @db.Decimal(24, 10)
  pddRange            String?     @map("pdd_range")
  referenceDate       DateTime    @map("reference_date") @db.Date
  originalDueDate     DateTime?   @map("original_due_date") @db.Date
  adjustedDueDate     DateTime?   @map("adjusted_due_date") @db.Date
  issuedAt            DateTime?   @map("issued_at") @db.Date
  acquiredAt          DateTime?   @map("acquired_at") @db.Date
  term                Int?
  currentTerm         Int?        @map("current_term")
  receivableSituation String?     @map("receivable_situation")
  assignmentRate      Decimal?    @map("assignment_rate") @db.Decimal(18, 10)
  receivableRate      Decimal?    @map("receivable_rate") @db.Decimal(18, 10)
  coobligation        String?
  createdAt           DateTime    @default(now()) @map("created_at")
  batch               ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fund                Fund        @relation(fields: [fundId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([fundId, referenceDate])
  @@index([referenceDate, cedentDocument])
  @@index([referenceDate, debtorDocument])
  @@map("receivable_stock_positions")
}

model FidcEstoque {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomeFundo              String
  docFundo               String?
  dataFundo              DateTime? @db.Date
  nomeGestor             String?
  docGestor              String?
  nomeOriginador         String?
  docOriginador          String?
  nomeCedente            String
  docCedente             String?
  nomeSacado             String
  docSacado              String?
  seuNumero              String?
  numeroDocumento        String
  tipoRecebivel          String?
  valorNominal           Decimal   @default(0) @db.Decimal(24, 10)
  valorPresente          Decimal   @default(0) @db.Decimal(24, 10)
  valorAquisicao         Decimal   @default(0) @db.Decimal(24, 10)
  valorPdd               Decimal   @default(0) @db.Decimal(24, 10)
  faixaPdd               String?
  dataReferencia         DateTime  @db.Date
  dataVencimentoOriginal DateTime  @db.Date
  dataVencimentoAjustada DateTime? @db.Date
  dataEmissao            DateTime? @db.Date
  dataAquisicao          DateTime? @db.Date
  prazo                  Int?
  prazoAnual             Int?
  situacaoRecebivel      String?
  taxaCessao             Decimal?  @db.Decimal(18, 10)
  taxaRecebivel          Decimal?  @db.Decimal(18, 10)
  coobrigacao            String?
  createdAt              DateTime  @default(now())

  @@unique([nomeFundo, dataReferencia, nomeCedente, dataVencimentoOriginal, valorPresente, numeroDocumento, nomeSacado], name: "fidc_estoques_logical_unique")
  @@index([dataReferencia, nomeFundo])
  @@index([dataReferencia, nomeCedente])
  @@index([numeroDocumento])
  @@map("FIDC_ESTOQUES")
}

model FidcMovimentoAberto {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String?      @map("batch_id")
  nomeFundo         String
  docFundo          String?
  dataMovimento     DateTime     @db.Date
  seuNumero         String?
  numeroDocumento   String
  tipoMovimento     String
  dataVencimento    DateTime     @db.Date
  valorAquisicao    Decimal      @default(0) @db.Decimal(24, 10)
  valorNominal      Decimal      @default(0) @db.Decimal(24, 10)
  valorMovimentacao Decimal      @default(0) @db.Decimal(24, 10)
  dataReferencia    DateTime     @db.Date
  periodo           String       @default("MANHA")
  createdAt         DateTime     @default(now())
  batch             ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([dataReferencia, periodo, nomeFundo, docFundo, dataMovimento, seuNumero, numeroDocumento, tipoMovimento, dataVencimento, valorAquisicao, valorNominal, valorMovimentacao], name: "fidc_movimentos_abertos_logical_unique")
  @@index([dataReferencia, nomeFundo])
  @@index([dataMovimento, nomeFundo])
  @@index([numeroDocumento])
  @@map("FIDC_MOVIMENTOS_ABERTOS")
}

model FidcLiquidadoBaixado {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId              String?      @map("batch_id")
  fundoNome            String
  fundoCnpj            String?
  dataDaPosicao        DateTime     @db.Date
  cedente              String
  identificacaoCedente String?
  sacado               String
  identificacaoSacado  String?
  txAquisicao          Decimal?     @db.Decimal(18, 10)
  idRecebivel          String
  valorAquisicao       Decimal      @default(0) @db.Decimal(24, 10)
  valorVencimento      Decimal      @default(0) @db.Decimal(24, 10)
  dataAquisicao        DateTime?    @db.Date
  dataVencimento       DateTime     @db.Date
  valorPago            Decimal      @default(0) @db.Decimal(24, 10)
  stRecebivel          String?
  ajuste               Decimal      @default(0) @db.Decimal(24, 10)
  numeroCorrespondente String?
  seuNumero            String?
  documento            String
  tipoRecebivel        String?
  tipoMovimento        String
  createdAt            DateTime     @default(now())
  batch                ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([fundoNome, fundoCnpj, dataDaPosicao, cedente, identificacaoCedente, sacado, identificacaoSacado, txAquisicao, idRecebivel, valorAquisicao, valorVencimento, dataAquisicao, dataVencimento, valorPago, stRecebivel, ajuste, numeroCorrespondente, seuNumero, documento, tipoRecebivel, tipoMovimento], name: "fidc_liquidados_baixados_logical_unique")
  @@index([dataDaPosicao, fundoNome])
  @@index([dataVencimento, fundoNome])
  @@index([idRecebivel])
  @@index([documento])
  @@index([seuNumero])
  @@map("FIDC_LIQUIDADOS_BAIXADOS")
}

model RiskLimitPosition {
  id                     String                @id @default(cuid())
  batchId                String
  referenceDate          DateTime              @map("reference_date") @db.Date
  cedentDimensionEntryId String?               @map("cedent_dimension_entry_id")
  code                   String?
  cedentName             String                @map("cedent_name")
  limitGlobal            Decimal               @default(0) @map("limit_global") @db.Decimal(24, 10)
  limitUsed              Decimal               @default(0) @map("limit_used") @db.Decimal(24, 10)
  limitAvailable         Decimal               @default(0) @map("limit_available") @db.Decimal(24, 10)
  overdueAmount          Decimal               @default(0) @map("overdue_amount") @db.Decimal(24, 10)
  pendingFinancialAmount Decimal               @default(0) @map("pending_financial_amount") @db.Decimal(24, 10)
  checkProblemAmount     Decimal               @default(0) @map("check_problem_amount") @db.Decimal(24, 10)
  checkToConfirmAmount   Decimal               @default(0) @map("check_to_confirm_amount") @db.Decimal(24, 10)
  proofOkAmount          Decimal               @default(0) @map("proof_ok_amount") @db.Decimal(24, 10)
  trancheTotal           Decimal               @default(0) @map("tranche_total") @db.Decimal(24, 10)
  trancheUsed            Decimal               @default(0) @map("tranche_used") @db.Decimal(24, 10)
  trancheAvailable       Decimal               @default(0) @map("tranche_available") @db.Decimal(24, 10)
  createdAt              DateTime              @default(now()) @map("created_at")
  batch                  ImportBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  cedentDimensionEntry   CedentDimensionEntry? @relation(fields: [cedentDimensionEntryId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([referenceDate])
  @@index([code])
  @@index([cedentDimensionEntryId])
  @@map("risk_limit_positions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
