{
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @osher/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/singulare-import",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/vop-snapshots",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/vop-snapshots",
      "schedule": "30 18 * * *"
    }
  ]
}
